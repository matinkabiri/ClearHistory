<Window x:Class="ClearHistory.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clear Recent Activity" Height="850" Width="1160" MinHeight="700" MinWidth="900" Background="#F4F7F9" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/><Setter Property="BorderBrush" Value="#E3E9ED"/><Setter Property="BorderThickness" Value="1"/></Style>
 </Window.Resources>
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,22"><StackPanel><TextBlock Text="Clear Recent Activity" FontSize="28" FontWeight="Bold" Foreground="#17212B"/><TextBlock Text="Review Windows file history before removing its shortcuts and references." Margin="0,6,0,0" Foreground="#687785" FontSize="14"/></StackPanel><Border DockPanel.Dock="Right" Background="#E5F2F6" CornerRadius="18" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="LOCAL · PRIVATE" FontSize="10" FontWeight="Bold" Foreground="#176B87"/></Border></DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Time range" FontWeight="SemiBold" Foreground="#17212B"/><ComboBox x:Name="RangeBox" Width="210" HorizontalAlignment="Left" Margin="0,9,0,0" SelectionChanged="RangeChanged"><ComboBoxItem Content="Last hour"/><ComboBoxItem Content="Last 24 hours" IsSelected="True"/><ComboBoxItem Content="Last 7 days"/><ComboBoxItem Content="Last 30 days"/><ComboBoxItem Content="All time"/><ComboBoxItem Content="Custom range…"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><DatePicker x:Name="FromDate" Width="140" Visibility="Collapsed"/><TextBlock x:Name="DateDash" Text="to" Margin="8,0" VerticalAlignment="Center" Visibility="Collapsed"/><DatePicker x:Name="ToDate" Width="140" Visibility="Collapsed"/></StackPanel></Grid></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="File history" FontWeight="Bold" FontSize="16"/><TextBlock Text="Recent shortcuts found in your Windows profile" Foreground="#687785" Margin="0,4,0,16"/><ItemsControl x:Name="CategoryList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="CategoryChanged" Unchecked="CategoryChanged"/><TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="#687785"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Explorer Home / Recent" FontWeight="Bold" FontSize="16"/><TextBlock Text="Select the entries you want to remove. The app asks Windows to remove each selected destination from Explorer’s automatic recent list and deletes only its Recent-folder shortcut. Original files stay untouched." Foreground="#687785" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="20,18"><StackPanel><TextBlock Text="Preview" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="PreviewSummary" Text="Matching recent shortcuts" Foreground="#687785" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshClick" Background="#EDF3F6" Foreground="#176B87"/></DockPanel><Border Grid.Row="1" Height="1" Background="#E3E9ED"/><DataGrid x:Name="PreviewGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F3" BorderThickness="0" RowHeight="50" ColumnHeaderHeight="38" Margin="0,0,0,0"><DataGrid.Columns><DataGridTextColumn Header="FILE" Binding="{Binding Name}" Width="1.15*"/><DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="75"/><DataGridTextColumn Header="LAST SEEN¹" Binding="{Binding TimestampText}" Width="145"/><DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="115"/><DataGridTextColumn Header="ORIGINAL LOCATION" Binding="{Binding Location}" Width="1.5*"/></DataGrid.Columns></DataGrid></Grid></Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,16,0,0"><StackPanel><TextBlock x:Name="StatusText" Text="Ready" Foreground="#687785"/><TextBlock Text="¹ Uses the shortcut’s modified time as a proxy; Windows does not expose a dependable last-opened time here." FontSize="11" Foreground="#83919B" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><CheckBox x:Name="DryRun" Content="Dry run" IsChecked="True" Margin="0,0,16,0"/><Button Content="Clear selected history" Click="ClearClick" Background="#176B87" Foreground="White"/></StackPanel></DockPanel>
 </Grid>
</Window>
